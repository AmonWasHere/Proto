    {"file": "src/ctrl_safe_path_canonical.java", "expect": "safe", "cwe": "CWE-22", "category": "pathtraver", "shape": "same constructor, canonical-path containment check", "pairs_with": "src/ctrl_pathtraver_file.java"}
