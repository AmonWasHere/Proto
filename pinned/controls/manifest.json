    {"file": "src/ctrl_ssrf_url.java", "expect": "vulnerable", "cwe": "CWE-918", "category": "ssrf", "shape": "URL.openConnection on a client-supplied URL"},
    {"file": "src/ctrl_open_redirect.java", "expect": "vulnerable", "cwe": "CWE-601", "category": "open_redirect", "shape": "sendRedirect to a client-supplied target"},
