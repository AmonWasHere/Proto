# RewardAudit secrets — copy to ~/.config/rewardaudit/env and chmod 600.
# Never commit this. Never paste a key into a tracked file.
#
#   mkdir -p ~/.config/rewardaudit
#   cp scripts/env.example ~/.config/rewardaudit/env
#   chmod 600 ~/.config/rewardaudit/env
#   $EDITOR ~/.config/rewardaudit/env

# --- cloud verifier (any OpenAI-compatible endpoint) ---
REWARDAUDIT_LLM_BASE_URL=https://api.deepseek.com/v1
REWARDAUDIT_LLM_MODEL=deepseek-chat
REWARDAUDIT_LLM_API_KEY=replace-me

# --- alternative: local server (no key) ---
# REWARDAUDIT_LLM_BASE_URL=http://localhost:11434/v1
# REWARDAUDIT_LLM_MODEL=qwen2.5-coder:7b
# REWARDAUDIT_LLM_API_KEY=local
