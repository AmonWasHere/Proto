#!/usr/bin/env bash
# Launch the RewardAudit web app and open it in the default browser.
# This is the only command the operator ever runs; end users just use the browser.
set -euo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"   # rewardaudit/
cd "$APP_DIR"
export PYTHONPATH="${PYTHONPATH:+$PYTHONPATH:}src"

PORT="${REWARDAUDIT_PORT:-8765}"
HOST="${REWARDAUDIT_HOST:-127.0.0.1}"

python3 -m rewardaudit.web --host "$HOST" --port "$PORT" &
SERVER_PID=$!
trap 'kill "$SERVER_PID" 2>/dev/null || true' EXIT

sleep 2
( xdg-open "http://${HOST}:${PORT}" >/dev/null 2>&1 || true ) &

wait "$SERVER_PID"
